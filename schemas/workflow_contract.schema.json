{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow_contract.schema.json",
  "title": "Workflow Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "revision", "status", "intent_digest", "steps", "revision_history"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["integer", "null"], "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "executing", "completed", "blocked", "failed"]
    },
    "intent_digest": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "revision_history": {
      "type": "array", "items": { "$ref": "#/$defs/revision" }
    }
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "action", "rationale", "inputs", "expected_outputs",
        "dependencies", "tools", "acceptance_criteria", "completion_check",
        "failure_handling", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^S-[0-9]+$" },
        "action": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "expected_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dependencies": {
          "type": "array", "items": { "type": "string", "pattern": "^S-[0-9]+$" }
        },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "acceptance_criteria": {
          "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
        },
        "completion_check": { "type": "string", "minLength": 1 },
        "failure_handling": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "failed", "skipped", "blocked"]
        },
        "command": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Optional literal argv to run inside the sandbox for this step (e.g. [\"python\", \"-c\", \"...\"] or [\"pytest\", \"tests/\"]). Omit for steps that are purely planning/inspection with no independent execution."
        },
        "file_writes": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileWrite" },
          "description": "Structured files to create inside the sandbox. Runtime compiles these entries into a deterministic writer command."
        },
        "kind": {
          "type": "string",
          "enum": ["action", "human_gate"],
          "default": "action",
          "description": "'human_gate' steps are never auto-executed regardless of `command` — execute_workflow halts at them and requires an explicit external approve_human_gate() call. This is a structural type, not a prompt instruction the model could omit under pressure — the direct fix for 'auto-escalation forbidden' being a rule someone has to remember rather than something the runtime enforces."
        }
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "fileWrite": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "reason", "material_changes"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "material_changes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
